<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>ZeroTrace</title>

  <style>

    :root {

      --bg: #0b0f14;
      --panel: #111720;
      --panel-2: #151c27;
      --border: #273241;
      --text: #f4f7fb;
      --muted: #8b98a9;
      --accent: #667eea;
      --facebook: #1877f2;
      --twitter: #ffffff;
      --danger: #ef4444;
      --success: #22c55e;

    }

    * {
      box-sizing: border-box;
    }

    html,
    body {

      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background: var(--bg);
      color: var(--text);

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    }

    body {
      min-height: 100vh;
    }

    .app {

      width: 100%;
      min-height: 100vh;
      padding: 24px 20px 28px;

    }

    /* ================================================================
       HEADER
       ================================================================ */

    .header {

      display: flex;
      align-items: center;
      gap: 13px;
      margin-bottom: 26px;

    }

    .logo {

      width: 42px;
      height: 42px;
      border-radius: 12px;

      display: flex;
      align-items: center;
      justify-content: center;

      background:
        linear-gradient(
          135deg,
          #667eea,
          #764ba2
        );

      box-shadow:
        0 8px 24px rgba(102, 126, 234, 0.25);

      overflow: hidden;
      flex-shrink: 0;

    }

    .logo img {

      width: 28px;
      height: 28px;
      object-fit: contain;

    }

    .brand {
      min-width: 0;
    }

    .brand-name {

      font-size: 19px;
      font-weight: 750;
      letter-spacing: -0.4px;

    }

    .brand-subtitle {

      margin-top: 2px;
      color: var(--muted);
      font-size: 12px;

    }

    /* ================================================================
       SECTION
       ================================================================ */

    .section {

      margin-bottom: 20px;

    }

    .section-label {

      margin-bottom: 9px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;

    }

    /* ================================================================
       PLATFORM SELECTOR
       ================================================================ */

    .platform-selector {

      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 5px;

      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 13px;

    }

    .platform-button {

      min-height: 46px;

      border: 0;
      border-radius: 9px;

      background: transparent;
      color: var(--muted);

      cursor: pointer;

      font-size: 13px;
      font-weight: 650;

      transition:
        background 0.15s ease,
        color 0.15s ease,
        transform 0.1s ease;

    }

    .platform-button:hover {

      color: var(--text);
      background: var(--panel-2);

    }

    .platform-button:active {

      transform: scale(0.98);

    }

    .platform-button.active {

      background: #1d2633;
      color: var(--text);

      box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.2);

    }

    .platform-icon {

      margin-right: 7px;
      font-weight: 800;

    }

    /* ================================================================
       NAVIGATION
       ================================================================ */

    .navigation-card-title {

      margin-bottom: 4px;
      font-size: 14px;
      font-weight: 700;

    }

    .navigation-card-description {

      margin-bottom: 14px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;

    }

    .nav-buttons {

      display: flex;
      flex-direction: column;
      gap: 8px;

    }

    .nav-button {

      width: 100%;
      min-height: 43px;
      padding: 0 13px;

      border: 1px solid var(--border);
      border-radius: 10px;

      background: var(--panel-2);
      color: var(--text);

      cursor: pointer;
      text-align: left;

      font-size: 13px;
      font-weight: 600;

      transition:
        border-color 0.15s ease,
        background 0.15s ease,
        transform 0.1s ease;

    }

    .nav-button:hover {

      border-color: #3b4a5e;
      background: #1a2330;

    }

    .nav-button:active {

      transform: scale(0.99);

    }

    /* ================================================================
       START / STOP
       ================================================================ */

    .actions {

      display: flex;
      flex-direction: column;
      gap: 9px;

    }

    .start-button,
    .stop-button {

      width: 100%;
      min-height: 48px;

      border: 0;
      border-radius: 11px;

      cursor: pointer;

      font-size: 14px;
      font-weight: 750;

      transition:
        transform 0.1s ease,
        opacity 0.15s ease,
        filter 0.15s ease;

    }

    .start-button {

      background:
        linear-gradient(
          135deg,
          #667eea,
          #764ba2
        );

      color: white;

      box-shadow:
        0 10px 25px rgba(102, 126, 234, 0.2);

    }

    .start-button:hover {

      filter: brightness(1.08);

    }

    .stop-button {

      display: block;

      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.35);

      color: #f87171;

    }

    .start-button:active,
    .stop-button:active {

      transform: scale(0.99);

    }

    /* ================================================================
       PROGRESS
       ================================================================ */

    #progressSection {

      display: none;

      padding: 16px;

      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;

    }

    .progress-header {

      display: flex;
      justify-content: space-between;
      align-items: center;

      margin-bottom: 12px;

    }

    .progress-title {

      font-size: 13px;
      font-weight: 700;

    }

    #deleteCounter {

      font-size: 18px;
      font-weight: 800;

    }

    .progress-bar {

      width: 100%;
      height: 6px;

      overflow: hidden;
      border-radius: 99px;

      background: #1d2632;

    }

    .progress-fill {

      width: 45%;
      height: 100%;

      border-radius: 99px;

      background:
        linear-gradient(
          90deg,
          #667eea,
          #a855f7
        );

      animation:
        progressPulse 1.3s ease-in-out infinite;

    }

    @keyframes progressPulse {

      0% {

        opacity: 0.55;
        transform: translateX(-20%);

      }

      50% {

        opacity: 1;

      }

      100% {

        opacity: 0.55;
        transform: translateX(160%);

      }

    }

    /* ================================================================
       STATUS
       ================================================================ */

    #statusMessage {

      margin-top: 12px;
      padding: 10px 11px;

      border-radius: 9px;

      background: #151c26;
      color: var(--muted);

      font-size: 11px;
      line-height: 1.45;

    }

    /* ================================================================
       FOOTER
       ================================================================ */

    .footer {

      margin-top: 26px;
      padding-top: 16px;

      border-top: 1px solid var(--border);

      color: #667384;
      text-align: center;

      font-size: 10px;
      line-height: 1.5;

    }

    /* ================================================================
       HIDDEN ELEMENTS / COMPATIBILITY
       ================================================================ */

    .hidden {

      display: none !important;

    }

  </style>

</head>

<body>

  <div class="app">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="header">

      <div class="logo">

        <img
          src="logo.png"
          alt="ZeroTrace"
          onerror="this.style.display='none'"
        >

      </div>

      <div class="brand">

        <div class="brand-name">
          ZeroTrace
        </div>

        <div class="brand-subtitle">
          Clean your social activity
        </div>

      </div>

    </div>


    <!-- ============================================================
         STEP 1 — PLATFORM
         ============================================================ -->

    <div class="section">

      <div class="section-label">
        Step 1: Choose platform
      </div>

      <div class="platform-selector">

        <button
          id="platformFacebook"
          class="platform-button active"
          type="button"
        >

          <span class="platform-icon">f</span>
          Facebook

        </button>

        <button
          id="platformTwitter"
          class="platform-button"
          type="button"
        >

          <span class="platform-icon">𝕏</span>
          X / Twitter

        </button>

      </div>

    </div>


    <!-- ============================================================
         ACTIVITY / CLEANUP SELECTION
         ============================================================ -->

    <div class="section">

      <div>

        <div
          id="step1Title"
          class="navigation-card-title"
        >

          Choose what to clean

        </div>

        <div class="navigation-card-description">

          Step 3: Select what you want ZeroTrace to clean.

        </div>

        <div class="nav-buttons">

          <button
            id="navigateComments"
            class="nav-button"
            type="button"
          >

            Posts / Comments

          </button>

          <button
            id="navigateReactions"
            class="nav-button"
            type="button"
          >

            Likes / Reactions

          </button>

          <button
            id="navigateReplies"
            class="nav-button"
            type="button"
          >

            Replies

          </button>

          <button
            id="navigateReposts"
            class="nav-button"
            type="button"
          >

            Reposts

          </button>

        </div>

        <div
          id="navigationNote"
          style="
            margin-top: 11px;
            color: #667384;
            font-size: 10px;
            line-height: 1.4;
          "
        ></div>

      </div>

    </div>


    <!-- ============================================================
         STEP 2 — START DELETING
         ============================================================ -->

    <div class="section">

      <div class="section-label">
        Step 4: Start deleting
      </div>

      <div class="actions">

        <button
          id="startDeletion"
          class="start-button"
          type="button"
        >

          Start Deleting

        </button>

        <button
          id="stopDeletion"
          class="stop-button"
          type="button"
        >

          Stop Deleting

        </button>

      </div>

    </div>


    <!-- ============================================================
         PROGRESS
         ============================================================ -->

    <div
      id="progressSection"
      class="section"
    >

      <div class="progress-header">

        <div class="progress-title">
          Cleanup in progress
        </div>

        <div id="deleteCounter">
          0
        </div>

      </div>

      <div class="progress-bar">

        <div class="progress-fill"></div>

      </div>

      <div id="statusMessage">

        Preparing cleanup...

      </div>

    </div>


    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <div class="footer">

      ZeroTrace runs locally in your browser.

      <br>

      Your social-media password is never required.

    </div>

  </div>


  <!-- ================================================================
       ZEROTrace PLATFORM FRAMEWORK
       ================================================================ -->

  <script src="platforms/registry.js"></script>

  <script src="platforms/facebook.js"></script>

  <script src="platforms/twitter.js"></script>


  <!-- ================================================================
       ZEROTrace MAIN CONTROLLER
       ================================================================ -->

  <script src="popup.js"></script>

</body>

</html>
